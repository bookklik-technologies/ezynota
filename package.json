{
  "name": "ezynota",
  "version": "0.3.0",
  "description": "A free, block-style editor with portable JSON output",
  "type": "module",
  "license": "MIT",
  "author": "Ezynota contributors",
  "keywords": [
    "editor",
    "block-editor",
    "rich-text",
    "contenteditable",
    "wysiwyg",
    "notes",
    "workspace",
    "json"
  ],
  "main": "./dist/ezynota.umd.cjs",
  "module": "./dist/ezynota.esm.js",
  "types": "./dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ezynota/ezynota.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/ezynota.esm.js",
      "require": "./dist/ezynota.umd.cjs"
    },
    "./core": {
      "types": "./dist/core-entry.d.ts",
      "import": "./dist/core.esm.js"
    },
    "./dist/ezynota.css": "./dist/ezynota.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "*.css",
    "./dist/ezynota.esm.js"
  ],
  "scripts": {
    "build": "vite build && vite build --config vite.umd.config.ts && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*\" \"tests/**/*\"",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^20.14.0",
    "eslint": "^9.9.0",
    "happy-dom": "^15.7.4",
    "lucide-static": "^1.43.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.70.0",
    "vite": "^5.4.2",
    "vitepress": "^1.6.4",
    "vitest": "^2.0.5"
  }
}
